{
  "name": "idsfind",
  "version": "3.1.1",
  "description": "",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist",
    "data/inverted_ids_all.json",
    "data/inverted_ids_first_level.json",
    "data/inverted_ids_remaining.json",
    "data/cjkvi.json",
    "data/Strokes.json"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf ./dist && tsup src/index.ts --format cjs,esm --dts --clean --shims",
    "build:update": "tsc -p tsconfig.scripts.json",
    "generate": "ts-node ./scripts/update.ts",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "keywords": [
    "Chinese Character",
    "Ideographic Description Sequence",
    "Unicode",
    "Kanji",
    "Hanzi"
  ],
  "author": "Guanwe Liu <toyjack@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/download": "^8.0.2",
    "@types/lodash": "^4.14.195",
    "chalk": "^5.2.0",
    "csv-parse": "^5.4.0",
    "download": "^8.0.0",
    "lodash": "^4.17.21",
    "rimraf": "^5.0.1",
    "ts-node": "^10.9.1",
    "tsup": "^7.1.0",
    "typescript": "^5.1.5"
  }
}
